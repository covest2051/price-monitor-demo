# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Вход в кабинет
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Пароль базы данных — любой длинный
POSTGRES_PASSWORD=

# true — при первом запуске добавить демо-товары с историей цен за 30 дней
DEMO_MODE=true

# Когда проверять цены (cron: секунды минуты часы день месяц день_недели), по умолчанию каждый день в 09:00
MONITOR_SCHEDULE=0 0 9 * * *
